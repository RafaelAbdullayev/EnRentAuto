# ─── База данных (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL="postgresql://enrent:enrent@localhost:5432/enrentauto?schema=public"

# ─── NextAuth v5 ──────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="ЗАМЕНИТЕ_МЕНЯ_openssl_rand_base64_32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# ─── Супер-админ (создаётся сид-скриптом при первом запуске) ──────────────
ADMIN_EMAIL="admin@enrentauto.ru"
ADMIN_PASSWORD="ChangeMe_Str0ng!"
ADMIN_NAME="Супер-администратор"

# ─── Прочее ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="EnRentAuto"
NEXT_PUBLIC_SITE_PHONE="+7 (999) 000-00-00"
# Максимальный размер одного фото, байт (по умолчанию 8 МБ)
UPLOAD_MAX_BYTES="8388608"
# Каталог хранения фотографий (по умолчанию <проект>/data/uploads).
# Вынесите его за пределы репозитория, чтобы фото переживали деплой:
# UPLOAD_DIR="/var/www/enrentauto-uploads"
