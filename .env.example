# ─── База данных (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL="postgresql://enrent:enrent@localhost:5432/enrentauto?schema=public"

# ─── NextAuth v5 ──────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="ЗАМЕНИТЕ_МЕНЯ_openssl_rand_base64_32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# ─── Супер-админ (создаётся сид-скриптом при первом запуске) ──────────────
# Логин администратора: e-mail или номер телефона
ADMIN_EMAIL="admin@enrentauto.ru"
ADMIN_PASSWORD="ChangeMe_Str0ng!"
ADMIN_NAME="Супер-администратор"

# ─── Прочее ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="EnRentAuto"
# Валюта площадки (ISO-4217). По умолчанию азербайджанский манат.
# Суммы хранятся целым числом в этой валюте — при смене кода значения в БД
# НЕ пересчитываются, их нужно обновить вручную.
NEXT_PUBLIC_CURRENCY="AZN"
# Телефон, e-mail и адрес больше не задаются здесь — они редактируются
# в админке: «Тексты сайта» → «Контакты и подвал».
# Максимальный размер одного фото, байт (по умолчанию 8 МБ)
UPLOAD_MAX_BYTES="8388608"          # картинки: 8 МБ
VIDEO_MAX_BYTES="41943040"          # видео: фон первого экрана и ролики авто, 40 МБ
# Каталог хранения фотографий (по умолчанию <проект>/data/uploads).
# Вынесите его за пределы репозитория, чтобы фото переживали деплой:
# UPLOAD_DIR="/var/www/enrentauto-uploads"

# Почта: подтверждение брони клиенту и коды входа в «Мои брони».
# Без этих настроек письма не отправляются, вход остаётся по номеру заказа.
# SMTP_HOST="smtp.timeweb.ru"
# SMTP_PORT="465"
# SMTP_USER="info@enrentauto.az"
# SMTP_PASSWORD="пароль-почтового-ящика"
# SMTP_FROM="EnRentAuto <info@enrentauto.az>"

# Перевод описаний автомобилей на языки сайта.
# Описание пишется по-русски в админке, остальные языки заполняются машиной
# при сохранении. Без ключа перевод недоступен — переводы можно вписать руками,
# а где их нет, показывается русский текст.
# Достаточно ОДНОГО из двух ключей (Claude переводит живее, особенно на азербайджанский):
# ANTHROPIC_API_KEY="sk-ant-..."
# TRANSLATE_MODEL="claude-opus-5"      # необязательно: другая модель Claude
# GOOGLE_TRANSLATE_API_KEY="..."       # Google Cloud Translation v2
